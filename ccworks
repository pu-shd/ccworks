#!/usr/bin/env zsh

# Dev-checkout launcher for ccworks.
#
# When installed via Homebrew (or `pip install ccworks`), an entry point named
# `ccworks` is provided directly on PATH by the package — this shell script
# is not used in that case.
#
# There is ONE command surface: the Python CLI (`ccworks <group> <subcommand>`).
# This launcher exists only to manage the dev .venv and to host the
# checkout-only chores (setup, test targets) that cannot work from an installed
# package. Every other argument list is forwarded verbatim, so
# `./ccworks report list` and `ccworks report list` behave identically.

set -euo pipefail

# Resolve the script's own directory so `./ccworks` works from any cwd.
SCRIPT_DIR="${0:A:h}"
cd "$SCRIPT_DIR"

# Checkout-only chores. Everything not listed here is forwarded to the CLI,
# which owns command validation, help text, and retired-name errors.
usage() {
    echo "Usage: ./ccworks <command> [args...]" >&2
    echo "" >&2
    echo "Dev-checkout tasks (handled by this launcher):" >&2
    echo "  setup                 Create .venv, install the package editable, install chromium" >&2
    echo "  test-local            Run mock unit tests locally on the host" >&2
    echo "  test-docker           Build and run mock unit tests inside Docker" >&2
    echo "  test-browser-smoke    Run Playwright browser CRUD smoke tests (local mock server)" >&2
    echo "  test-reports-live     Run Playwright reports CRUD smoke test against real Concur" >&2
    echo "  test-receipts-live    Run Playwright receipts smoke test against real Concur" >&2
    echo "" >&2
    echo "All other arguments are forwarded to the ccworks CLI:" >&2
    echo "" >&2
}

# Activate the local dev venv, creating it (with the package installed
# editable) on first use.
ensure_venv() {
    if [ ! -d ".venv" ]; then
        echo "Virtual environment not found. Setting it up first..." >&2
        # Every line of bootstrap chatter goes to stderr: stdout is the data
        # channel (query commands emit JSON there), so on a fresh checkout pip
        # output would otherwise be prepended to a command's JSON result.
        python3 -m venv .venv >&2
        source .venv/bin/activate
        pip install --upgrade pip >&2
        pip install -r requirements.lock -e . >&2
        # Honour the same escape hatch the Python runtime bootstrap uses, so CI
        # and containers that manage browsers themselves skip the ~180 MB
        # chromium download.
        if [ "${CCWORKS_SKIP_BROWSER_BOOTSTRAP:-}" != "1" ]; then
            playwright install chromium >&2
        fi
    else
        source .venv/bin/activate
    fi
}

# Confirm docker + docker-compose are available before invoking them.
# Docker Desktop / OrbStack / Colima are installed as casks or externally,
# so we can't ship them as a formula dependency — check at runtime instead.
require_docker_compose() {
    if ! command -v docker >/dev/null 2>&1; then
        echo "[ERROR] 'docker' is not on PATH." >&2
        echo "        Install Docker Desktop (brew install --cask docker), OrbStack," >&2
        echo "        or Colima before running docker-based commands." >&2
        exit 127
    fi
    if command -v docker-compose >/dev/null 2>&1; then
        COMPOSE_CMD=(docker-compose)
    elif docker compose version >/dev/null 2>&1; then
        COMPOSE_CMD=(docker compose)
    else
        echo "[ERROR] Neither 'docker-compose' nor 'docker compose' is available." >&2
        echo "        Install the Docker Compose plugin or standalone docker-compose." >&2
        exit 127
    fi
}

# Run the packaged CLI. Works from a fresh dev checkout because ensure_venv
# does `pip install -e .`, which registers the `ccworks` module.
run_cli() {
    python -m ccworks.cli "$@"
}

# Bare `./ccworks`: list the dev tasks, then let the CLI print its own reference.
if [ $# -lt 1 ]; then
    usage
    ensure_venv
    run_cli
    exit 0
fi

case "$1" in
    setup)
        echo "=== Setting up local Python Virtual Environment ===" >&2
        python3 -m venv .venv
        source .venv/bin/activate
        pip install --upgrade pip
        pip install -r requirements.lock -e .
        echo "=== Installing Playwright browser binaries ===" >&2
        playwright install chromium
        echo "Setup complete! Activate using: source .venv/bin/activate" >&2
        ;;
    test-local)
        echo "=== Running local unit tests ===" >&2
        ensure_venv
        python3 -m unittest discover -s tests
        ;;
    test-docker)
        echo "=== Running containerized unit tests via Docker Compose ===" >&2
        require_docker_compose
        "${COMPOSE_CMD[@]}" build unit-tests
        "${COMPOSE_CMD[@]}" run --rm unit-tests
        ;;
    test-browser-smoke)
        echo "=== Running Playwright Browser CRUD Smoke Tests ===" >&2
        ensure_venv
        python3 tests/test_browser_smoke.py
        ;;
    test-reports-live)
        echo "=== Running Live Concur Reports Smoke Test ===" >&2
        ensure_venv
        python3 tests/smoke_test_reports.py
        ;;
    test-receipts-live)
        echo "=== Running Live Concur Receipts Smoke Test ===" >&2
        ensure_venv
        python3 tests/smoke_test_receipts.py "${@:2}"
        ;;
    *)
        # Single front door: forward verbatim to the CLI.
        ensure_venv
        run_cli "$@"
        ;;
esac
